{
  "functions": {
    "api/*.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/assessment",
      "destination": "https://docs.google.com/forms/d/e/1FAIpQLSevCnynE8nkXUfzOt-W662pRdu6RfXh-easWsaynuwIrwOsWQ/viewform",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|@vite/|@react-refresh|@fs/|src/|node_modules/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
